{
  "name": "background-span-demo",
  "private": true,
  "scripts": {
    "build": "npm run build:grid && npm run build:marker-free && npm run build:anchor-marker",
    "build:grid": "tailwindcss -i ./grid/input.css -o ./grid/output.css --optimize",
    "build:marker-free": "tailwindcss -i ./anchor-marker-free/input.css -o ./anchor-marker-free/output.css --optimize",
    "build:anchor-marker": "tailwindcss -i ./anchor-marker/input.css -o ./anchor-marker/output.css --optimize",
    "watch:grid": "tailwindcss -i ./grid/input.css -o ./grid/output.css --optimize --watch=always",
    "watch:marker-free": "tailwindcss -i ./anchor-marker-free/input.css -o ./anchor-marker-free/output.css --optimize --watch=always",
    "watch:anchor-marker": "tailwindcss -i ./anchor-marker/input.css -o ./anchor-marker/output.css --optimize --watch=always"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "tailwindcss": "^4.3.5"
  }
}
